#!/bin/sh
# 全局 pre-commit 入口：交给同目录的 pre-commit.ps1 做规模检查 + 密钥扫描。
# 门禁默认 fail-closed：找不到 PowerShell 时拒绝提交，避免"看起来有门禁其实没有"。
# 临时跳过：CODE_STANDARDS_ALLOW_SKIP=1 git commit ...
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/pre-commit.ps1"
fi
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/pre-commit.ps1"
fi
if [ "${CODE_STANDARDS_ALLOW_SKIP:-0}" = "1" ]; then
  echo "code-standards: 未找到 PowerShell，按 CODE_STANDARDS_ALLOW_SKIP=1 放行" >&2
  exit 0
fi
echo "code-standards: 未找到 PowerShell（pwsh / powershell.exe），拒绝提交。" >&2
echo "  安装 PowerShell 7 后重试；或临时设置 CODE_STANDARDS_ALLOW_SKIP=1；或 git commit --no-verify。" >&2
exit 1